# PubAPI OffSec — configuration (all optional; defaults shown)

# Interface to bind. 0.0.0.0 = all interfaces (reachable from network);
# 127.0.0.1 = localhost only.
HOST=0.0.0.0

# HTTP port to listen on
PORT=8080

# Gin mode: release | debug
GIN_MODE=release

# Per-IP rate limit (token bucket)
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# Network dial timeout for scans/lookups, in milliseconds
DIAL_TIMEOUT_MS=3000

# Safety caps for port scanning
MAX_SCAN_PORTS=1024
SCAN_CONCURRENCY=100

# Allow targeting private/loopback/link-local IPs.
# Keep FALSE for any internet-facing deployment (prevents SSRF against your
# own internal network and cloud metadata). Set TRUE only for isolated,
# authorized internal-network testing.
ALLOW_PRIVATE_TARGETS=false

# Cache slow external lookups (crt.sh, WHOIS, Wayback, GeoIP, DNS) in memory.
CACHE_ENABLED=true

# --- Accounts, API keys & logging (SQLite) ---
# Path to the SQLite database (users, API keys, request logs).
DB_PATH=pubapi.db
# Bootstrap admin account, created on first run if it does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Authentication (optional; disabled by default) ---
# When true, the recon/scan/web/util API requires a client API key or JWT.
# Accounts, dashboard, and admin routes work regardless of this flag.
AUTH_ENABLED=false
# HMAC secret for signing session JWTs. If empty, a random ephemeral secret is
# generated (sessions will not survive a restart).
JWT_SECRET=
# Session-token lifetime, in minutes.
JWT_TTL_MINUTES=60

# Stricter per-IP rate limit for /auth/login and /auth/register to blunt
# credential brute-force and mass account creation.
AUTH_RATE_RPS=0.1
AUTH_RATE_BURST=5
