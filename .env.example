# PubAPI OffSec — configuration (all optional; defaults shown)

# Interface to bind. 0.0.0.0 = all interfaces (reachable from network);
# 127.0.0.1 = localhost only.
HOST=0.0.0.0

# HTTP port to listen on
PORT=8080

# Gin mode: release | debug
GIN_MODE=release

# Per-IP rate limit (token bucket)
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# Network dial timeout for scans/lookups, in milliseconds
DIAL_TIMEOUT_MS=3000

# Safety caps for port scanning
MAX_SCAN_PORTS=1024
SCAN_CONCURRENCY=100

# Allow targeting private/loopback/link-local IPs.
# Keep FALSE for any internet-facing deployment (prevents SSRF against your
# own internal network and cloud metadata). Set TRUE only for isolated,
# authorized internal-network testing.
ALLOW_PRIVATE_TARGETS=false

# Cache slow external lookups (crt.sh, WHOIS, Wayback, GeoIP, DNS) in memory.
CACHE_ENABLED=true

# --- Authentication (optional; disabled by default) ---
# When true, every /api/v1/* endpoint requires an API key or JWT.
# Public routes (/, /docs, /api, /health, /api/v1/auth/token) stay open.
AUTH_ENABLED=false
# Comma-separated list of valid API keys.
AUTH_API_KEYS=
# HMAC secret for signing JWTs. If empty while auth is on, a random ephemeral
# secret is generated (issued tokens will not survive a restart).
JWT_SECRET=
# Lifetime of issued JWTs, in minutes.
JWT_TTL_MINUTES=60
